# These are some examples of commonly ignored file patterns.
# You should customize this list as applicable to your project.
# Learn more about .gitignore:
#     https://www.atlassian.com/git/tutorials/saving-changes/gitignore

# Node artifact files
node_modules/
dist/

# Compiled Java class files
*.class

# Compiled Python bytecode
*.py[cod]

# Log files
*.log

# Package files
*.jar

# Maven
target/
dist/

# JetBrains IDE
.idea/

# Unit test reports
TEST*.xml

# Generated by MacOS
.DS_Store

# Generated by Windows
Thumbs.db

# Applications
*.app
*.exe
*.war

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv

# Additional stuff from DSPC

__pycache__
_b*
/.venv*
/venv*
/.vscode
.vs
.ThirdParty-SrcCache
*_release.aws
/awe_manager/tests/data/designs/**/_*.yml
/_generated_docs
/dist
pip.conf
out/*

# Meant to store user configuration. Use CMakePresets.json for configuration
# that should be included in the repo.
CMakeUserPresets.json

# Deprecated. Use CMakePresets.json instead.
CMakeSettings.json

# CMake is configured to use the /build/ directory for builds. We also mask
# directories in the root starting with /build for developer convenience.
/build*/

# The Jenkinsfile uses this directory to collect code quality reports.
# Excluding it so that git doesn't mark the working tree dirty.
/reports/

# ignore the files generated by AWEMgr-Shell
.awemgrshell.history
