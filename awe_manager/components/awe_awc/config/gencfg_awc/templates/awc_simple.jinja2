{%- set awb = yml_extensions['_tmp_ext']['awb'] -%}
{%- set awbfile = awb['awb_file'] -%}
{%- set ctrlh_modules = yml_extensions['_tmp_ext']['ctrl_h']['modules'] -%}
#
# DSPC AWC FILE
#
# generated by PyCtrlIO version: {{ ctrlio_version }}
#
# Schema / File Format 
# This number will increase once an incompatible modification becomes necessary.
# Do not modify unless you know what you do!
_INFO_,schema_version,2

# *****************************************************************************
# Customer Fields
#

# This field can be used to pass a version information to AWE Manager.
# 
_INFO_,version,1.2.3-version

# Use this field to provide a date information to AWE Manager.
# This info can be used on the target platform for tracing output.
#
# _INFO_,date,1970-01-01

# An arbitrary description of this file can be passed to AWE Manager.
# This info can be used on the target platform for tracing output.
#
_INFO_,description,This is an AWC file

# END OF "Customer Fields"
# *****************************************************************************

# Delimiter for the control items (mod<delim>var)
_INFO_,ctl_delimiter,.

# Number of AWECore instances the main design runs on or requires.
# If this number is >1 then the integration needs to ensure
# that all secondary AWECore instances have been started and
# are enabled to receive AWB commands (i.e. loading a
# design will only be possible then)
#
# _INFO_,nr_instances,{{awb.nr_instances}}

#
# Statistic Data - also helps parsing rest of file. Do not modify!
#
_INFO_,nr_awb,1
_INFO_,nr_mod,{{ ctrlh_modules | length }}
{%- set nr_ctls = [0] -%}
{%- for mod in ctrlh_modules -%}
    {%- set vl = mod['variables'] | length -%}
    {%- if nr_ctls.append(nr_ctls.pop()+ vl) -%}{%- endif %}
{%- endfor %}
_INFO_,nr_ctl,{{ nr_ctls[0] }}
{%- set utils = namespace(events_map={}) %}
{%- for mod in ctrlh_modules %}
	{%- if mod.classID == 0xbeef0da6 %}
        {%- set utils.events_map = utils.events_map.update({mod.ID: mod.name}) or utils.events_map %}
    {%- endif %}
{%- endfor %}
{%- set nr_evts = utils.events_map | length  %}
_INFO_,nr_evts,{{ nr_evts }}

# ---- Main AWB + Presets ----

# _AWB_,endPointId, Name/Label, FileName, Size, MD5sum
_AWB_,{{ awb['instanceId'] }},{{ awb['awb_label'] }},{{ awb['awb_file'].split('/')[-1] }},{{ awb['file_sz'] }},{{ awb['file_md5'] }}
# note: preset-AWB not yet generated
# _AWB_,1,PresetName,awbfilename.awb,sz,md5sum

# ---- CTL modules (AWIDL access) ----

# _CTL_,name,handle,size,index
{%- for mod in ctrlh_modules -%}
    {%- set mod_var = mod['variables'][0] %}
    {%- for idl_mod in info['classes'] -%}
        {%- if mod.name in idl_mod.awd_key %}
{{ idl_mod.name }},{{ mod_var.handle }},{{ mod_var.size }},{{ 0 }}
            {%- for v in idl_mod['items'] %}
{{ idl_mod.name }}.{{ v.name }},{{ mod_var.handle }},{{ 1 }},{{ v.index }}
            {%- endfor %}
        {%- endif %}
    {%- endfor %}
{%- endfor %}

# ---- CTL modules (SYS access) ----

#_MOD_,name,classId,objectId,nr_vars
#_CTL_,name,handle,size,offset,def,min,max,step,type,alias 
{% for mod in ctrlh_modules %}
_MOD_,{{ mod.name }},{{ mod.classID }},{{ mod.ID }},{{ mod['variables'] | length }}
    {%- for v in mod['variables'] %}
_CTL_,{{ mod.name }}.{{ v.name }},{{ v.handle }},{{ v.size }},0,0,0,0,0,{{v.type}}
    {%- endfor %}
{%- endfor %}

# Ranges
{%- for mod in ctrlh_modules -%}
    {% set mod_var = mod['variables'][0] %}
    {% for idl_mod in info['classes'] -%}
        {%- if mod.name in idl_mod.awd_key %}
            {%- for v in idl_mod['items'] -%}
                {% if v.type == 'range' %}
{{ idl_mod.name }}.{{ v.name }},{{ v['value'] }},{{ v['values']['min_val'] }},{{ v['values']['max_val'] }},{{ v['values']['step'] }}
                {%- elif v.type == 'bool' %}
{{ idl_mod.name }}.{{ v.name }},{{ v['value'] | int() }},0,1,
                {%- else %}
# {{ idl_mod.name }}.{{ v.name }},range= {{ v }}
                {%- endif %}
            {%- endfor %}
        {%- endif %}
    {%- endfor %}
{%- endfor %}

#Events
#_EVT_,objectId,name
{%- for objectid, name in utils.events_map.items() %}
_EVT_,{{ objectid }},{{ name }}
{%- endfor %}
{# ### DATA INCLUDED #} 

{# {{ yml_extensions | pprint }} #}